{
  "name": "bone-zone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "deploy": "npm run build && npm run build:single && node scripts/deploy.mjs",
    "preview": "vite preview",
    "test": "esbuild tests/logic.test.ts --bundle --platform=node --jsx=automatic --log-level=warning --outfile=node_modules/.cache/logic.test.cjs && node node_modules/.cache/logic.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
